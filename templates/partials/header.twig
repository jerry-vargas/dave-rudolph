{% set assetVersion = today|date|kebab %}
<!doctype html>
<html lang="en">

<head>
    {# Meta Tags partial #}
    {% include 'partials/_metaTags.twig' %}

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0W6WHPF89H"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-0W6WHPF89H');
    </script>

    <!-- Google verification search console meta tag -->
    <meta name="google-site-verification" content="RAs97KAS_R5U95P59jIXknrtXYuUUdMEM3sszSzBMDk"/>
    <title>Dave Rudolph Music</title>

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png">
{#    <link rel="manifest" href="/site.webmanifest">#}
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    {# templates/_layout.twig, inside <head> #}
    <script type="application/ld+json">
        {{ {
            "@context": "https://schema.org",
            "@type": "MusicGroup",
            "name": "Dave Rudolph",
            "url": siteUrl,
            "sameAs": [
                "https://www.facebook.com/DaveRudolphMusic",
                "https://www.instagram.com/daverudolphmusic",
                "https://open.spotify.com/artist/4Ait3rFDQIoOA1Z5JrEBsp"
            ]
        } | json_encode | raw }}

    </script>
    <script>
      // Apply dark mode immediately - no flash!
      (function() {
        const theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }
      })();
    </script>
    {{ craft.vite.script("src/app.js", false) }}
</head>
<body class="relative">
