{% extends '_layout.twig' %}
{% block content %}

    <main class="container mx-auto flex flex-col items-center justify-center min-h-[60vh] px-4 py-16 text-center">
        <p class="font-xball text-primary text-[8rem] sm:text-[12rem] leading-none text-shadow-2xs select-none">
            {{ statusCode ?? 'Error' }}
        </p>
        <h1 class="font-russo text-2xl sm:text-4xl md:text-5xl mt-4 mb-6">
            {{ name ?? 'Something Went Wrong' }}
        </h1>
        <p class="font-russo text-gray-500 text-base sm:text-lg md:text-xl max-w-lg mb-10">
            {{ message ?? 'An unexpected error occurred. Please try again or head back home.' }}
        </p>
        <a href="/"
           class="font-russo text-primary border-2 border-primary rounded-full px-8 py-3 text-lg hover:text-secondary hover:border-secondary transform hover:scale-105 transition duration-300 ease-out">
            Back to Home
        </a>
    </main>

{% endblock %}
